{
    "name": "phil/taxonomy-bundle",
    "description": "Tags and a translated tree of categories for any resource of a Symfony application: find or create, rename, move without cycles, merge, and their form types",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "categories",
        "symfony-bundle",
        "tags",
        "taxonomy"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "doctrine/orm": "^3.7",
        "phil/resource": "^0.1@dev",
        "phil/slug": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/uid": "^8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/persistence": "^4.1",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/translation-contracts": "^3.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\TaxonomyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\TaxonomyBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
